modules = ["web", "nodejs-20", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "./deploy.sh"]
run = ["sh", "-c", "NODE_ENV=production node index.js"]

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5174
externalPort = 80

[env]
PORT = "3000"
NODE_ENV = "production"
VITE_PORT = "5174"

[processes]
dev = "npm run dev"

[workflow]
defaultTask = "dev"

[[workflow.tasks]]
name = "dev"
command = "concurrently \"cd server && tsx watch --clear-screen=false index.ts\" \"cd client && npm run dev\""

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Deployment Server"

[[workflows.workflow]]
name = "Deployment Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 NODE_ENV=production node index.js"
waitForPort = 5000
