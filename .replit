modules = ["web", "nodejs-20", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "cd client && npm run build"]
run = ["sh", "-c", "node index.js"]

[[deployment.rewrites]]
from = "/api/*"
to = "/api/*"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 80

[[ports]]
localPort = 5177
externalPort = 3002

[[ports]]
localPort = 9005
externalPort = 3001

[[ports]]
localPort = 9006
externalPort = 3003

[[ports]]
localPort = 24678
externalPort = 4200

[env]
PORT = "3000"
VITE_PORT = "5174"

[[hints]]
regex = "Error: "
allowIn = ["DevLogs"]
command = "npm run dev"
name = "Error"

[processes]
dev = "npm run dev"

[workflow]
defaultTask = "dev"

[[workflow.tasks]]
name = "dev"
command = "concurrently \"cd server && tsx watch --clear-screen=false index.ts\" \"cd client && npm run dev\""

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Development Servers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Smart Deploy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Development App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Production Deploy"

[[workflows.workflow]]
name = "Development Servers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run dev & cd server && npm run dev"
waitForPort = 5174

[[workflows.workflow]]
name = "Smart Deploy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run build && cd ../server && npm run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Development App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run dev -- --port 5000 --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Production Deploy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node production-deployment-server.js"
waitForPort = 3000
