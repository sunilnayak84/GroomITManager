rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isManager() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'manager';
    }

    // Users collection
    match /users/{userId} {
      // Allow admins to read and write all user documents
      allow read: if isSignedIn();
      allow create: if isAdmin() || isManager();
      allow update: if isAdmin() || isManager() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Roles collection
    match /roles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isManager();
    }
  }
}
