
{
  "rules": {
    "roles": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('roles').child(auth.uid).child('role').val() === 'admin'",
        ".write": "root.child('roles').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('roles').child(auth.uid).child('role').val() === 'admin'",
        ".write": "$uid === auth.uid || root.child('roles').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
