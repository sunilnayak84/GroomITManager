# Production environment variables
# These values will be used when building for production

# Firebase Configuration
VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY}
VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID}
VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID}
VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_PROJECT_ID}.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=${VITE_FIREBASE_PROJECT_ID}.appspot.com

# API Configuration - Use Firebase Functions deployed URL in production
VITE_API_BASE_URL=https://us-central1-${VITE_FIREBASE_PROJECT_ID}.cloudfunctions.net/api